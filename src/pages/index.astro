
---
const habilidades = [
  {
    nombre: 'Python y FastAPI',
    detalle: 'Prácticas de programación, creación de endpoints y servicios backend para aplicaciones.'
  },
  {
    nombre: 'Bases de datos',
    detalle: 'Consultas SQL, organización de información y conexión de bases de datos con aplicaciones.'
  },
  {
    nombre: 'Desarrollo web',
    detalle: 'Creación de páginas con Astro e integración de interfaces con servicios backend.'
  },
  {
    nombre: 'Redes de computadoras',
    detalle: 'Topologías, direccionamiento IP y simulación de redes con Cisco Packet Tracer.'
  },
  {
    nombre: 'Electrónica',
    detalle: 'Prácticas con ESP32, lectores RFID y tarjetas para proyectos interactivos.'
  },
  {
    nombre: 'Integración de tecnologías',
    detalle: 'Interés en combinar programación, hardware y recursos digitales para crear proyectos.'
  }
];

const proyectos = [
  {
    numero: '01',
    categoria: 'INNOVACIÓN Y TECNOLOGÍA',
    nombre: 'Hackatec',
    detalle: 'En México existe una desconexión entre las instituciones de educación superior y el sector productivo. Muchas micro, pequeñas y medianas empresas enfrentan dificultades tecnológicas y operativas que afectan su productividad y competitividad. Además, no siempre cuentan con áreas de investigación y desarrollo ni con recursos para contratar consultorías especializadas.',
    aporte: 'La propuesta busca acercar el talento universitario, el conocimiento científico y los recursos tecnológicos a las necesidades reales de las empresas, impulsando la colaboración y el desarrollo de soluciones útiles.'
  },
  {
    numero: '02',
    categoria: 'DESARROLLO WEB Y APIS',
    nombre: 'Páginas web conectadas con APIs',
    detalle: 'Prácticas de desarrollo web utilizando Astro y servicios backend con Python y FastAPI, trabajando con rutas, endpoints e intercambio de información entre una página web y un servidor.',
    aporte: 'Estas prácticas me han permitido conocer mejor cómo se comunican una página web y un servidor, además de explorar la conexión con bases de datos y la presentación de información dinámica.'
  },
  {
    numero: '03',
    categoria: 'TECNOLOGÍA Y CULTURA',
    nombre: 'Lotería Interactiva Mazahua',
    detalle: 'Proyecto educativo que combina una lotería tradicional con tecnología para apoyar el aprendizaje y la preservación de la lengua mazahua entre estudiantes de educación primaria.',
    aporte: 'La propuesta integra un ESP32, tarjetas RFID, imágenes y audios para relacionar palabras en mazahua con sus significados en español y su pronunciación, haciendo del aprendizaje una experiencia interactiva.'
  }
];
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f0e7" />
    <meta
      name="description"
      content="Portafolio personal de Ana Laura, estudiante de Ingeniería Informática."
    />
    <title>Ana Laura | Mi portafolio</title>
  </head>

  <body>
    <header class="navbar">
      <a class="brand" href="#inicio">A.L.</a>

      <nav aria-label="Navegación principal">
        <a href="#perfil">Sobre mí</a>
        <a href="#educacion">Educación</a>
        <a href="#habilidades">Habilidades</a>
        <a href="#proyectos">Proyectos</a>
        <a href="#contacto">Contacto</a>
      </nav>
    </header>

    <main>
      <!-- PRESENTACIÓN -->
      <section class="hero" id="inicio">
        <div class="hero-copy">
          <p class="eyebrow">MI ESPACIO · MI APRENDIZAJE · MIS PROYECTOS</p>

          <h1>
            Hola, soy
            <span>Ana Laura.</span>
            <br />
            Y esto es parte de mi camino.
          </h1>

          <p class="intro">
            Soy estudiante de Ingeniería Informática y me gusta aprender
            cosas nuevas relacionadas con la tecnología. Durante la carrera
            he trabajado con programación en Python, bases de datos,
            desarrollo web y redes de computadoras. Me gusta poner en práctica
            lo que aprendo, experimentar con distintas herramientas y crear
            proyectos que tengan una utilidad, como mis prácticas de desarrollo
            web y la Lotería Interactiva Mazahua.
          </p>

          <div class="interests">
            <span>Programación</span>
            <span>Desarrollo web</span>
            <span>Bases de datos</span>
            <span>Redes</span>
          </div>

          <div class="actions">
            <a class="button primary" href="#proyectos">
              Conoce mis proyectos ↗
            </a>
            <a class="button secondary" href="#contacto">
              Hablemos
            </a>
          </div>

          <p class="hero-note">
            APRENDIENDO ALGO NUEVO EN CADA PROYECTO
          </p>
        </div>

        <!-- FOTO DE PERFIL -->
        <div class="portrait-area">
          <div class="portrait-frame">
            <img
              src="/images/estudiante.jpg"
              alt="Fotografía de Ana Laura"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            />

            <div class="portrait-placeholder">
              <span>MI PORTAFOLIO</span>
              <strong>A.L.</strong>
              <small>Ingeniería Informática</small>
            </div>
          </div>

          <p class="portrait-caption">
            Un poco de mí y de lo que voy construyendo.
          </p>
        </div>
      </section>

      <!-- SOBRE MÍ -->
      <section class="section about" id="perfil">
        <p class="eyebrow">01 / SOBRE MÍ</p>
        <h2>Aprender, experimentar y crear.</h2>

        <div class="about-grid">
          <p class="lead">
            Me gusta conocer cómo funcionan las cosas y descubrir todo lo
            que puedo hacer con la tecnología.
          </p>

          <div class="about-copy">
            <p>
              En Ingeniería Informática he tenido la oportunidad de trabajar
              con diferentes herramientas y conocer áreas como la programación,
              las bases de datos, las redes y el desarrollo web.
            </p>

            <p>
              He realizado prácticas con Python y FastAPI, trabajado con
              bases de datos y explorado proyectos que combinan software
              y electrónica. También me gusta que los proyectos tengan
              un propósito, como ocurre con la Lotería Interactiva Mazahua,
              que relaciona la tecnología con el aprendizaje y la cultura.
            </p>

            <p>
              Todavía tengo muchas cosas por aprender, pero quiero seguir
              practicando, mejorar mis habilidades y participar en proyectos
              que me ayuden a crecer tanto personal como profesionalmente.
            </p>
          </div>
        </div>
      </section>

      <!-- EDUCACIÓN -->
      <section class="section education" id="educacion">
        <p class="eyebrow">02 / MI FORMACIÓN</p>
        <h2>Educación.</h2>

        <article class="education-card">
          <div class="education-label">
            <span class="education-icon">✳</span>
            <span>FORMACIÓN ACADÉMICA</span>
          </div>

          <div>
            <h3>Ingeniería Informática</h3>
            <p class="institution">
              Tecnológico de Estudios Superiores de San Felipe del Progreso
            </p>
            <p>
              Mi formación me ha permitido conocer distintas áreas de la
              informática, desde la programación y la administración de datos
              hasta las redes de computadoras, la electrónica y el desarrollo
              de aplicaciones.
            </p>
          </div>
        </article>
      </section>

      <!-- OBJETIVO PROFESIONAL -->
      <section class="section goal">
        <p class="eyebrow">03 / LO QUE QUIERO LOGRAR</p>

        <h2>Seguir creciendo y llevar mis ideas más lejos.</h2>

        <p class="goal-text">
          A futuro me gustaría desarrollarme profesionalmente en el área del
          desarrollo de software, mejorar mis conocimientos sobre bases de
          datos y aprender nuevas herramientas que me permitan crear
          aplicaciones útiles. También quiero participar en proyectos donde
          pueda poner en práctica lo que sé, trabajar con otras personas y
          adquirir experiencia. Mi meta es seguir aprendiendo y encontrar
          oportunidades para convertir mis ideas en soluciones reales.
        </p>

        <span class="goal-signature">
          Poco a poco, pero siempre aprendiendo.
        </span>
      </section>

      <!-- HABILIDADES -->
      <section class="section skills" id="habilidades">
        <p class="eyebrow">04 / LO QUE HE APRENDIDO</p>
        <h2>Herramientas y habilidades.</h2>

        <p class="section-intro">
          Estas son algunas de las áreas y tecnologías que he conocido y
          utilizado durante mi formación y mis prácticas.
        </p>

        <div class="skill-grid">
          {habilidades.map((habilidad, index) => (
            <article class="skill-card">
              <span class="skill-number">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3>{habilidad.nombre}</h3>
              <p>{habilidad.detalle}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- PROYECTOS DESTACADOS -->
      <section class="section projects" id="proyectos">
        <p class="eyebrow">05 / COSAS EN LAS QUE HE TRABAJADO</p>
        <h2>Proyectos destacados.</h2>

        <p class="section-intro">
          Cada proyecto representa una oportunidad para aprender algo
          diferente, probar herramientas y aplicar mis conocimientos.
        </p>

        <div class="project-list">
          {proyectos.map((proyecto) => (
            <article class="project-card">
              <div class="project-top">
                <span class="project-number">{proyecto.numero}</span>
                <span class="project-category">{proyecto.categoria}</span>
              </div>

              <h3>{proyecto.nombre}</h3>
              <p class="project-description">{proyecto.detalle}</p>

              <div class="project-contribution">
                <span>¿DE QUÉ TRATA?</span>
                <p>{proyecto.aporte}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- CONTACTO -->
      <section class="contact" id="contacto">
        <p class="eyebrow">06 / CONTACTO</p>

        <h2>¿Te gustaría ponerte en contacto conmigo?</h2>

        <p>
          Si quieres hablar sobre alguno de mis proyectos, compartir ideas
          o ponerte en contacto conmigo, puedes escribirme por WhatsApp.
        </p>

        <a
          class="button light"
          href="https://wa.me/525656860160"
          target="_blank"
          rel="noopener noreferrer"
        >
          Escribirme por WhatsApp ↗
        </a>

        <p class="phone"></p>
      </section>
    </main>

    <footer>
      <a class="brand" href="#inicio">A.L.</a>
      <p>Ana Laura Ruiz Martinez</p>
      <a href="#inicio">Volver al inicio ↑</a>
    </footer>
  </body>
</html>

<style>
  :root {
    --wine: #713648;
    --wine-dark: #442630;
    --cream: #f7f0e7;
    --paper: #fffaf4;
    --coffee: #70574b;
    --muted: #927c70;
    --line: #e6d8cb;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 95px;
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--wine-dark);
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.8;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .navbar {
    position: sticky;
    top: 0;
    z-index: 10;
    min-height: 76px;
    padding: 15px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 22px;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }

  .brand {
    color: var(--wine);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.65rem;
    font-weight: bold;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    font-size: 0.8rem;
  }

  nav a,
  footer a {
    transition: color 0.2s ease;
  }

  nav a:hover,
  footer a:hover {
    color: var(--wine);
  }

  .hero {
    min-height: 620px;
    padding: 75px 10%;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: center;
    gap: 45px;
    background: var(--cream);
  }

  .eyebrow {
    color: var(--wine);
    font-size: 0.72rem;
    font-weight: bold;
    letter-spacing: 0.14em;
  }

  h1,
  h2 {
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: normal;
    line-height: 1.2;
  }

  h1 {
    margin: 24px 0;
    font-size: clamp(2.5rem, 4.3vw, 4.2rem);
  }

  h1 span {
    display: inline-block;
    color: var(--wine);
    font-style: italic;
  }

  h2 {
    margin: 16px 0 28px;
    font-size: clamp(2rem, 3.7vw, 3.2rem);
  }

  .intro {
    max-width: 620px;
    color: var(--coffee);
    font-size: 0.98rem;
  }

  .interests {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 22px;
  }

  .interests span {
    padding: 5px 12px;
    border: 1px solid #d9c5b8;
    border-radius: 30px;
    color: var(--wine);
    background: var(--paper);
    font-size: 0.75rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .button {
    display: inline-block;
    padding: 11px 18px;
    border: 1px solid var(--wine);
    font-size: 0.84rem;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .primary {
    color: white;
    background: var(--wine);
  }

  .primary:hover {
    background: var(--wine-dark);
  }

  .secondary:hover {
    color: white;
    background: var(--wine);
  }

  .hero-note {
    margin-top: 32px;
    color: var(--muted);
    font-size: 0.67rem;
    letter-spacing: 0.1em;
  }

  /* FOTOGRAFÍA */

  .portrait-area {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .portrait-frame {
    width: 255px;
    height: 255px;
    max-width: 75vw;
    max-height: 75vw;
    padding: 7px;
    overflow: hidden;
    border: 1px solid #c9a696;
    border-radius: 50%;
    background: #e6d5c5;
    box-shadow: 0 15px 40px #44263016;
  }

  .portrait-frame img {
    display: block;
    width: 100%;
    height: 100%;
    border: 4px solid var(--paper);
    border-radius: 50%;
    object-fit: cover;
    object-position: center 35%;
  }

  .portrait-placeholder {
    display: none;
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 4px solid var(--paper);
    border-radius: 50%;
    color: var(--wine);
    text-align: center;
  }

  .portrait-placeholder span {
    font-size: 0.6rem;
    letter-spacing: 0.1em;
  }

  .portrait-placeholder strong {
    font: normal 4.5rem Georgia, serif;
  }

  .portrait-placeholder small {
    color: var(--coffee);
  }

  .portrait-caption {
    max-width: 300px;
    margin: 22px 0 0;
    color: var(--coffee);
    font: italic 0.95rem Georgia, serif;
    text-align: center;
  }

  .section {
    padding: 85px 10%;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 55px;
  }

  .lead {
    margin-top: 0;
    color: var(--wine-dark);
    font: 1.65rem/1.5 Georgia, serif;
  }

  .about-copy {
    color: var(--coffee);
  }

  .about-copy p:first-child {
    margin-top: 0;
  }

  .education {
    background: #f0e4d8;
  }

  .education-card {
    padding: 32px;
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 28px;
    border: 1px solid var(--line);
    background: var(--paper);
  }

  .education-label {
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: var(--wine);
    font-size: 0.68rem;
    font-weight: bold;
    letter-spacing: 0.09em;
  }

  .education-icon {
    font-size: 1.8rem;
  }

  .education-card h3 {
    margin-top: 0;
    font: normal 1.8rem Georgia, serif;
  }

  .education-card p {
    color: var(--coffee);
  }

  .education-card .institution {
    color: var(--wine);
    font-weight: bold;
  }

  .goal {
    background: var(--wine-dark);
  }

  .goal .eyebrow {
    color: #e4c4b7;
  }

  .goal h2 {
    max-width: 760px;
    color: var(--paper);
  }

  .goal-text {
    max-width: 800px;
    color: #eddfd7;
    font-size: 1rem;
  }

  .goal-signature {
    display: inline-block;
    margin-top: 15px;
    color: #e4c4b7;
    font: italic 1.05rem Georgia, serif;
  }

  .skills {
    background: var(--cream);
  }

  .section-intro {
    max-width: 700px;
    color: var(--coffee);
  }

  .skill-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: 35px;
  }

  .skill-card {
    padding: 25px;
    border: 1px solid var(--line);
    background: var(--paper);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .skill-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 25px #4426300c;
  }

  .skill-number {
    color: var(--wine);
    font: 1.4rem Georgia, serif;
  }

  .skill-card h3 {
    font-size: 1.03rem;
    line-height: 1.45;
  }

  .skill-card p {
    margin-bottom: 0;
    color: var(--coffee);
    font-size: 0.88rem;
  }

  .project-list {
    display: grid;
    gap: 20px;
    margin-top: 35px;
  }

  .project-card {
    padding: 30px;
    border: 1px solid var(--line);
    background: var(--paper);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .project-card:hover {
    transform: translateY(-3px);
    border-color: #c9a696;
  }

  .project-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .project-number {
    color: var(--wine);
    font: 1.4rem Georgia, serif;
  }

  .project-category {
    color: var(--wine);
    font-size: 0.67rem;
    font-weight: bold;
    letter-spacing: 0.09em;
  }

  .project-card h3 {
    margin: 15px 0;
    font: normal 1.8rem Georgia, serif;
  }

  .project-description {
    color: var(--coffee);
    font-size: 0.92rem;
  }

  .project-contribution {
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }

  .project-contribution span {
    color: var(--wine);
    font-size: 0.68rem;
    font-weight: bold;
    letter-spacing: 0.1em;
  }

  .project-contribution p {
    margin-bottom: 0;
    color: var(--coffee);
    font-size: 0.9rem;
  }

  .contact {
    padding: 80px 10%;
    color: var(--paper);
    background: var(--wine);
    text-align: center;
  }

  .contact .eyebrow {
    color: #f0d7ca;
  }

  .contact h2 {
    max-width: 720px;
    margin: 20px auto;
  }

  .contact > p:not(.eyebrow) {
    max-width: 650px;
    margin: 0 auto 25px;
    color: #f0e2db;
  }

  .contact .light {
    color: var(--wine-dark);
    background: var(--cream);
    border-color: var(--cream);
  }

  .contact .light:hover {
    background: white;
  }

  .contact .phone {
    margin-top: 22px !important;
    font-size: 0.88rem;
  }

  footer {
    padding: 25px 8%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 15px;
    font-size: 0.8rem;
  }

  footer p {
    color: var(--muted);
  }

  @media (max-width: 850px) {
    .navbar {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
    }

    nav {
      gap: 10px 16px;
    }

    .hero {
      padding: 60px 7%;
      grid-template-columns: 1fr;
      gap: 35px;
    }

    .portrait-area {
      grid-row: 1;
    }

    .hero-copy {
      grid-row: 2;
    }

    .portrait-frame {
      width: 225px;
      height: 225px;
    }

    .section {
      padding: 65px 7%;
    }

    .about-grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .education-card {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .skill-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .hero {
      padding: 45px 6%;
    }

    .portrait-frame {
      width: 205px;
      height: 205px;
    }

    .portrait-caption {
      font-size: 0.85rem;
    }

    .skill-grid {
      grid-template-columns: 1fr;
    }

    .project-card {
      padding: 22px;
    }

    .project-card h3 {
      font-size: 1.55rem;
    }

    .project-category {
      font-size: 0.6rem;
    }

    .education-card {
      padding: 23px;
    }

    .contact {
      padding: 65px 7%;
    }

    footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
